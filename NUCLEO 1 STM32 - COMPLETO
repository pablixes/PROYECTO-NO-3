        diagBytesESP++;
        ringPush(&fromESP, byteESP);

        (void)HAL_UART_Receive_IT(
            &huart1, &byteESP, 1
        );

    } else if (h->Instance == USART3) {

        diagBytesN2++;
        ringPush(&fromN2, byteN2);

        (void)HAL_UART_Receive_IT(
            &huart3, &byteN2, 1
        );
    }
}

void HAL_UART_ErrorCallback(
    UART_HandleTypeDef *h)
{
    if (h->Instance == USART1) {

        (void)HAL_UART_Receive_IT(
            &huart1, &byteESP, 1
        );

    } else if (h->Instance == USART3) {

        (void)HAL_UART_Receive_IT(
            &huart3, &byteN2, 1
        );
    }
}

