// ============================================================
// MAIN PRINCIPAL
// ============================================================

int main(void)
{
    HAL_Init();
    SystemClock_Config();

    MX_GPIO_Init();
    MX_I2C1_Init();
    MX_USART1_UART_Init();
    MX_USART2_UART_Init();
    MX_USART3_UART_Init();
    MX_DAC_Init();
    MX_TIM1_Init();

    /* USER CODE BEGIN 2 */

    if (HAL_UART_Receive_IT(
            &huart1, &byteESP, 1U) != HAL_OK)
        Error_Handler();

    if (HAL_UART_Receive_IT(
            &huart3, &byteN2, 1U) != HAL_OK)
        Error_Handler();

    neoDMAInit();
    audioInit();
    stateIdle();

    report("NUCLEO 1 LISTA - LECTURA / GUARDAR\r\n");

    uint32_t diagInicio = HAL_GetTick();
    uint32_t diagUltimo = diagInicio;
    uint8_t diagPingEnviado = 0;

    sendU(
        &huart2,
        "DIAG N1: UART1 ESP32 / UART3 NUCLEO2 activos\r\n"
    );

    /* USER CODE END 2 */

    while (1)
    {
        /* USER CODE BEGIN 3 */

        readPort(
            &fromESP,
            cmdESP,
            &nESP,
            sizeof(cmdESP),
            1
        );

        readPort(
            &fromN2,
            cmdN2,
            &nN2,
            sizeof(cmdN2),
            0
        );

        // PING de diagnostico
        if (!diagPingEnviado &&
            pending == 0 &&
            HAL_GetTick() - diagInicio >= 2500U) {

            diagPingEnviado = 1;
            pending = 3;
            pendingSince = HAL_GetTick();

            sendU(
                &huart2,
                "DIAG N1: enviando PING por USART3 a Nucleo 2\r\n"
            );

            sendU(&huart3, "PING\n");
        }

        // Diagnostico UART cada 5 segundos
        if (HAL_GetTick() - diagUltimo >= 5000U) {

            diagUltimo = HAL_GetTick();

            snprintf(
                salida,
                sizeof(salida),
                "DIAG N1: bytes ESP32/USART1=%lu | N2/USART3=%lu\r\n",
                (unsigned long)diagBytesESP,
                (unsigned long)diagBytesN2
            );

            sendU(&huart2, salida);
        }

        uint32_t tiempoLimite =
            (pending == 2U) ? 12000U : 6000U;

        if (pending &&
            (uint32_t)(HAL_GetTick() - pendingSince)
                > tiempoLimite) {

            if (pending == 4 ||
                pending == 5 ||
                pending == 3) {

                report(
                    "ERROR: SIN ACK DE NUCLEO 2 - REVISAR UART3 Y CABLE PC11\r\n"
                );

            } else {

                report(
                    "ERROR: NUCLEO 2 NO COMPLETO LA OPERACION\r\n"
                );
            }

            pending = 0;
            stateError();
            stateHold(1900);
        }

        // Regresar NeoPixel al estado inicial
        if (neoUntil &&
            (int32_t)(HAL_GetTick() - neoUntil) >= 0) {

            neoUntil = 0;
            stateIdle();
        }

        audioTick();
        neoTick();

        HAL_Delay(1);

        /* USER CODE END 3 */
    }
}

