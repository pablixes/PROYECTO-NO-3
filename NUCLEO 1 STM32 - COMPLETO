static void neoColor(
    uint8_t r, uint8_t g, uint8_t b)
{
    neoR = r;
    neoG = g;
    neoB = b;
    neoChanged = 1;
}

static void neoTick(void)
{
    if (!neoChanged || neoBusy) return;

    neoChanged = 0;

    uint32_t rgb =
        ((uint32_t)neoG << 16) |
        ((uint32_t)neoR << 8) |
        neoB;

    for (uint8_t i = 0; i < 24U; i++) {
        neoPwm[i] =
            (rgb & (1UL << (23U - i)))
            ? NEO_DUTY_1 : NEO_DUTY_0;
    }

    for (uint8_t i = 24U;
         i < sizeof(neoPwm) / sizeof(neoPwm[0]);
         i++) {
        neoPwm[i] = 0;
    }

    neoBusy = 1;

    __HAL_TIM_SET_COUNTER(&htim1, 0);

    if (HAL_TIM_PWM_Start_DMA(
            &htim1,
            TIM_CHANNEL_1,
            (uint32_t *)neoPwm,
            (uint16_t)(
                sizeof(neoPwm) /
                sizeof(neoPwm[0])
            )
        ) != HAL_OK) {
        neoBusy = 0;
    }
}

