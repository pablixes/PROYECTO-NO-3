// ============================================================
// PROTOCOLO UART
// ============================================================

static void ringPush(Ring *q, uint8_t b)
{
    uint16_t nx = (q->wr + 1U) % RING_CAP;

    if (nx == q->rd) {
        q->over = 1;
        return;
    }

    q->data[q->wr] = b;
    q->wr = nx;
}

static uint8_t ringPop(Ring *q, uint8_t *out)
{
    if (q->rd == q->wr) return 0;

    *out = q->data[q->rd];
    q->rd = (q->rd + 1U) % RING_CAP;

    return 1;
}

static void sendU(UART_HandleTypeDef *h, const char *s)
{
    HAL_UART_Transmit(
        h,
        (uint8_t *)s,
        (uint16_t)strlen(s),
        300
    );
}

static void report(const char *s)
{
    sendU(&huart2, s);
    sendU(&huart1, s);
}

