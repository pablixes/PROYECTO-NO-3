void HAL_TIM_PeriodElapsedCallback(TIM_HandleTypeDef *htim)
{
    if (htim->Instance != TIM6) return;

    uint32_t step = sfxStep;

    if (step == 0U) {
        HAL_DAC_SetValue(
            &hdac,
            DAC_CHANNEL_1,
            DAC_ALIGN_12B_R,
            0U
        );
        return;
    }

    sfxPhase += step;

    uint16_t saw = (uint16_t)(sfxPhase >> 20);
    uint16_t tri = (saw < 2048U)
                 ? saw : (4095U - saw);

    uint32_t val = 950U + (uint32_t)tri;

    HAL_DAC_SetValue(
        &hdac,
        DAC_CHANNEL_1,
        DAC_ALIGN_12B_R,
        val
    );
}

static void audioInit(void)
{
    __HAL_RCC_TIM6_CLK_ENABLE();

    htim6app.Instance = TIM6;
    htim6app.Init.Prescaler = 20U;
    htim6app.Init.CounterMode = TIM_COUNTERMODE_UP;
    htim6app.Init.Period = 124U;
    htim6app.Init.AutoReloadPreload =
        TIM_AUTORELOAD_PRELOAD_DISABLE;

    if (HAL_TIM_Base_Init(&htim6app) != HAL_OK)
        Error_Handler();

    if (HAL_DAC_Start(&hdac, DAC_CHANNEL_1) != HAL_OK)
        Error_Handler();

    HAL_DAC_SetValue(
        &hdac, DAC_CHANNEL_1,
        DAC_ALIGN_12B_R, 0U
    );

    HAL_NVIC_SetPriority(TIM6_DAC_IRQn, 6, 0);
    HAL_NVIC_EnableIRQ(TIM6_DAC_IRQn);
}

static void audioNote(uint16_t hz)
{
    if (hz == 0U) {
        sfxStep = 0;
        HAL_DAC_SetValue(
            &hdac, DAC_CHANNEL_1,
            DAC_ALIGN_12B_R, 0U
        );
        return;
    }

    uint32_t step =
        (uint32_t)(((uint64_t)hz << 32) /
                   SFX_SAMPLE_RATE);

    __disable_irq();
    sfxPhase = 0;
    sfxStep = step;
    __enable_irq();
}

static void audioStop(void)
{
    HAL_TIM_Base_Stop_IT(&htim6app);

    sfxStep = 0;
    sfxPhase = 0;
    sfxNotas = NULL;
    sfxTotal = 0;
    sfxIndice = 0;

    HAL_DAC_SetValue(
        &hdac, DAC_CHANNEL_1,
        DAC_ALIGN_12B_R, 0U
    );
}

static void audioPlay(const Nota *notes, uint8_t n)
{
    if (notes == NULL || n == 0U) return;

    HAL_TIM_Base_Stop_IT(&htim6app);

    HAL_DAC_SetValue(
        &hdac, DAC_CHANNEL_1,
        DAC_ALIGN_12B_R, 0U
    );

    sfxNotas = notes;
    sfxTotal = n;
    sfxIndice = 0;

    audioNote(notes[0].hz);
    sfxHasta = HAL_GetTick() + notes[0].ms;

    __HAL_TIM_SET_COUNTER(&htim6app, 0);

    if (HAL_TIM_Base_Start_IT(&htim6app) != HAL_OK)
        Error_Handler();
}

static void audioTick(void)
{
    if (!sfxNotas ||
        (int32_t)(HAL_GetTick() - sfxHasta) < 0)
        return;

    sfxIndice++;

    if (sfxIndice >= sfxTotal) {
        audioStop();
        return;
    }

    audioNote(sfxNotas[sfxIndice].hz);

    sfxHasta =
        HAL_GetTick() + sfxNotas[sfxIndice].ms;
}

